# ============================================================
# FlowAds — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# ---------------------------
# SUPABASE (obrigatório)
# ---------------------------
# URL do seu projeto Supabase (ex: https://xxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Chave anônima (pública) — usada pelo frontend
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço (privada) — usada pelo backend com permissão total
# NUNCA exponha esta chave no frontend
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------
# SEGURANÇA
# ---------------------------
# Chave de 32 caracteres para criptografia de dados sensíveis
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ---------------------------
# URLS
# ---------------------------
# URL do frontend (para configurar CORS no backend)
FRONTEND_URL=http://localhost:3000

# URL do backend (para o frontend chamar as APIs)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------
# REDIS
# ---------------------------
# URL do Redis para filas BullMQ
REDIS_URL=redis://localhost:6379

# ---------------------------
# META / FACEBOOK ADS (opcional — configurável via UI)
# ---------------------------
# Token de acesso de longo prazo para Meta API
# Pode ser configurado por cliente ou globalmente
META_TOKEN=

# ---------------------------
# WHATSAPP API (opcional — configurável via UI)
# Compatível com Evolution API ou Z-API
# ---------------------------
WHATSAPP_API_URL=http://your-evolution-api:8080
WHATSAPP_TOKEN=your-whatsapp-api-token
WHATSAPP_DEFAULT_NUMBER=5511999999999

# ---------------------------
# OPENAI (opcional — configurável via UI)
# ---------------------------
OPENAI_API_KEY=sk-...

# ---------------------------
# ANTHROPIC (opcional — configurável via UI)
# ---------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------
# GOOGLE DRIVE (opcional)
# ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback

# ---------------------------
# NOTION (opcional)
# ---------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4000/oauth/notion/callback

# ---------------------------
# SERVIDOR
# ---------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
