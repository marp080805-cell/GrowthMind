# ============================================================
# FlowAds — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# ---------------------------
# ADMIN (login fixo do sistema)
# ---------------------------
# Credenciais do administrador principal — salvas no servidor, nunca expostas ao browser
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=sua-senha-forte-aqui

# Segredo para assinar os tokens de sessão — gere com: openssl rand -hex 32
AUTH_SECRET=your-auth-secret-32-chars-minimum

# ---------------------------
# SUPABASE (todas server-only — nunca use NEXT_PUBLIC_ nessas)
# ---------------------------
# URL da API do seu projeto — encontre em: Supabase → Settings → General → Project URL
# ATENÇÃO: deve ser https://xxxxxxxxxxx.supabase.co — NÃO uma connection string postgresql://
SUPABASE_URL=https://your-project-ref.supabase.co

# Chave anônima — Supabase → Settings → API Keys → aba "Legacy anon, service_role API keys" → anon
# (Na nova UI do Supabase, use a aba "Legacy" para pegar chaves no formato eyJ... compatíveis com supabase-js v2)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço — Supabase → Settings → API Keys → aba "Legacy anon, service_role API keys" → service_role
# NUNCA exponha esta chave no frontend
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------
# SEGURANÇA
# ---------------------------
# Chave de 32 caracteres para criptografia de dados sensíveis
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ---------------------------
# URLS
# ---------------------------
# URL do frontend (para configurar CORS no backend)
FRONTEND_URL=https://seudominio.com

# URL pública do backend (para o frontend chamar as APIs)
NEXT_PUBLIC_API_URL=https://seudominio.com

# ---------------------------
# REDIS
# ---------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------
# META / FACEBOOK ADS (opcional — configurável via UI)
# ---------------------------
META_TOKEN=

# ---------------------------
# WHATSAPP API (opcional — configurável via UI)
# Compatível com Evolution API ou Z-API
# ---------------------------
WHATSAPP_API_URL=http://your-evolution-api:8080
WHATSAPP_TOKEN=your-whatsapp-api-token
WHATSAPP_DEFAULT_NUMBER=5511999999999

# ---------------------------
# OPENAI (opcional — configurável via UI)
# ---------------------------
OPENAI_API_KEY=sk-...

# ---------------------------
# ANTHROPIC (opcional — configurável via UI)
# ---------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------
# GOOGLE DRIVE (opcional)
# ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seudominio.com/oauth/google/callback

# ---------------------------
# NOTION (opcional)
# ---------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://seudominio.com/oauth/notion/callback

# ---------------------------
# SERVIDOR
# ---------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
