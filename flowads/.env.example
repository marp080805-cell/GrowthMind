# ============================================================
# FlowAds — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# ---------------------------
# ADMIN (login fixo do sistema)
# ---------------------------
# Credenciais do administrador principal — salvas no servidor, nunca expostas ao frontend
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=sua-senha-forte-aqui

# Segredo para assinar os tokens de sessão (mínimo 32 caracteres)
# Gere com: openssl rand -hex 32
AUTH_SECRET=your-auth-secret-32-chars-minimum

# ---------------------------
# SUPABASE (servidor — nunca expostas ao browser)
# ---------------------------
# URL do seu projeto Supabase (ex: https://xxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Chave anônima — usada pelo servidor para autenticar usuários comuns via Supabase Auth
# NÃO use o prefixo NEXT_PUBLIC_ para não expor no browser
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço (privada) — usada pelo backend para operações administrativas no banco
# NUNCA exponha esta chave no frontend
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------
# CONEXÃO DIRETA AO BANCO (para Prisma / migrações, se necessário)
# ---------------------------
# Use o Session Pooler do Supabase (IPv4 — funciona em VPS sem IPv6 nativo)
# Formato: postgresql://postgres.[project-ref]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxx@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# URL direta para migrações — use também o pooler (porta 5432) para evitar problema de IPv6 em VPS
# Formato idêntico ao DATABASE_URL ou com ?pgbouncer=true removido
DIRECT_URL=postgresql://postgres.xxxxx@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------
# SEGURANÇA
# ---------------------------
# Chave de 32 caracteres para criptografia de dados sensíveis
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ---------------------------
# URLS
# ---------------------------
# URL do frontend (para configurar CORS no backend)
FRONTEND_URL=http://localhost:3000

# URL do backend (para o frontend chamar as APIs)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------
# REDIS
# ---------------------------
# URL do Redis para filas BullMQ
REDIS_URL=redis://localhost:6379

# ---------------------------
# META / FACEBOOK ADS (opcional — configurável via UI)
# ---------------------------
META_TOKEN=

# ---------------------------
# WHATSAPP API (opcional — configurável via UI)
# Compatível com Evolution API ou Z-API
# ---------------------------
WHATSAPP_API_URL=http://your-evolution-api:8080
WHATSAPP_TOKEN=your-whatsapp-api-token
WHATSAPP_DEFAULT_NUMBER=5511999999999

# ---------------------------
# OPENAI (opcional — configurável via UI)
# ---------------------------
OPENAI_API_KEY=sk-...

# ---------------------------
# ANTHROPIC (opcional — configurável via UI)
# ---------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------
# GOOGLE DRIVE (opcional)
# ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback

# ---------------------------
# NOTION (opcional)
# ---------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4000/oauth/notion/callback

# ---------------------------
# SERVIDOR
# ---------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
